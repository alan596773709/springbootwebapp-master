# 数据库环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值
# 注意：生产环境请不要将 .env 文件提交到版本控制系统

# 数据库配置
DB_URL=jdbc:mysql://127.0.0.1:3306/logistics?useSSL=false&serverTimezone=GMT
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# 顺丰API配置
SF_CLIENT_CODE=your_client_code_here
SF_CHECK_WORD=your_check_word_here
SF_API_URL=https://sfapi.sf-express.com/std/service

# 使用方法:
# Windows: set DB_URL=jdbc:mysql://...
# Linux/Mac: export DB_URL=jdbc:mysql://...
# 或者在启动命令中指定: java -jar app.jar --DB_URL=jdbc:mysql://...
